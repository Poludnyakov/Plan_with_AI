# Add these lines to the SAME protected planiruy.env used by docker compose.
MAX_BOT_TOKEN=token_from_MAX_business_console
MAX_BOT_USERNAME=username_without_at
MAX_WEBHOOK_SECRET=generate_with_openssl_rand_hex_32
MAX_PUBLIC_BASE_URL=https://planwithai.ru
# Short name from MAX Mini App settings. Leave blank to open the app attached to this bot.
MAX_MINIAPP_NAME=
MAX_API_BASE_URL=https://platform-api2.max.ru
MAX_AUTO_REGISTER_WEBHOOK=true
